# Secretos. La letra prohibe explicitamente versionar contrasenas reales y
# claves privadas: esto es la segunda red de contencion, la primera es que la
# passphrase del vault vive en ~/.ansible/, fuera del repositorio.
vault_pass*
.vault_pass*
group_vars/all/vault_plain.yml
*.pem
*.key
id_rsa*
id_ed25519*

# Colecciones bajadas por ansible-galaxy: se declaran en requirements.yml, no
# se versionan.
collections/

# Ruido
*.retry
__pycache__/
*.pyc
.DS_Store
Thumbs.db
